    {
      "name": "Create agent-created M6 ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAgent}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\"requestTypeId\":{{requestTypeIdM6}},\"summary\":\"DDA2-QA-BFLA-agent-created M6 ticket-{{qaRunTag}}\",\"description\":\"Synthetic isolated BFLA ownership fixture.\",\"formData\":{}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"synthetic ownership ticket created\", () => pm.response.to.have.status(201));",
              "pm.test(\"agent-created M6 ticket response contains ticket id\", () => { const body = pm.response.json(); pm.expect(body.ticketId).to.be.a(\"string\"); pm.environment.set(\"ticketAgentM6\", body.ticketId); });"
            ]
          }
        }
      ]
    },
