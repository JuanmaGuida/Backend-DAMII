{
  "info": {
    "name": "DDA2 synthetic role boundary probes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Synthetic QA requests generated from src/main/resources/static/openapi.yaml. No shared service is called."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18080"
    }
  ],
  "item": [
    {
      "name": "Login synthetic Citizen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"citizen@example.test\",\"password\":\"{{citizenPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"synthetic login succeeds\", () => pm.response.to.have.status(200));",
              "pm.test(\"login identity is CITIZEN\", () => { const body = pm.response.json(); pm.expect(body).to.have.property(\"identity\"); pm.expect(body.identity.role).to.eql(\"CITIZEN\"); });",
              "pm.environment.set(\"tokenCitizen\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login synthetic Agent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
