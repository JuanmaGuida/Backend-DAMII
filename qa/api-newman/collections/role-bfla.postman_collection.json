              "pm.test(\"login identity is AGENT\", () => { const body = pm.response.json(); pm.expect(body).to.have.property(\"identity\"); pm.expect(body.identity.role).to.eql(\"AGENT\"); });",
              "pm.environment.set(\"tokenAgent\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
