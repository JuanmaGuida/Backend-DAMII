# Copiar este archivo como .env para personalizar el entorno local.
# Estos valores son solo para desarrollo y no deben usarse en producción.
POSTGRES_DB=reclamos
POSTGRES_USER=reclamos
POSTGRES_PASSWORD=reclamos_local
POSTGRES_PORT=5432
APP_PORT=8080
# Generate once per environment; see docs/tracking-code-encryption.md. No default key.
TRACKING_CODE_ENCRYPTION_KEY_BASE64=
TRACKING_CODE_ENCRYPTION_KEY_ID=
MOCK_CITIZEN_PASSWORD=replace_with_a_local_citizen_password
MOCK_AGENT_PASSWORD=replace_with_a_local_agent_password
MOCK_AREA_RESPONSIBLE_PASSWORD=replace_with_a_local_area_password
MOCK_ADMIN_PASSWORD=replace_with_a_local_admin_password
SIMULATOR_ENABLED=false
# Core publication is opt-in. Manual mode sends only explicitly reviewed eventId UUIDs.
# In manual mode an empty list sends nothing. Never approve mock/simulated data.
CORE_OUTBOX_ENABLED=false
# Manual: AUTO=false and explicit APPROVED_EVENT_IDS. Automatic: AUTO=true,
# IDENTITY_PROVIDER=M1, SIMULATOR_ENABLED=false, OUTBOX_ENABLED=true and empty APPROVED_EVENT_IDS.
# Only new eligible events are automatic; V50 never enrolls existing events/tickets.
CORE_OUTBOX_AUTO_APPROVE_NEW_EVENTS=false
CORE_OUTBOX_APPROVED_EVENT_IDS=
CORE_RABBIT_HOST=core-uade-2026.duckdns.org
CORE_RABBIT_PORT=5671
CORE_RABBIT_VHOST=core
CORE_RABBIT_USERNAME=
CORE_RABBIT_PASSWORD=
CORE_OUTBOX_MAX_ATTEMPTS=5
CORE_OUTBOX_RETRY_DELAY=15s
CORE_OUTBOX_CONFIRM_TIMEOUT=5s
CORE_OUTBOX_CONNECT_TIMEOUT=5s
CORE_OUTBOX_SCAN_DELAY=1000
CORE_INBOX_ENABLED=false
CORE_INBOX_PREFETCH=1
CORE_INBOX_RECONNECT_DELAY=5000
# M1 is disabled until deliberately configured. Never commit a real APP_JWT_SECRET.
IDENTITY_PROVIDER=MOCK
M1_BASE_URL=https://ciudadanos-m1-backend.onrender.com
APP_JWT_SECRET=
# Exact HTTPS origin of the M2 browser application (scheme, hostname, optional port).
M2_AUTH_BROWSER_ORIGIN=
M1_CONNECT_TIMEOUT=5s
M1_READ_TIMEOUT=30s
ATTACHMENT_STORAGE_ROOT=/var/lib/m2/attachments
ATTACHMENT_MAX_FILES=5
ATTACHMENT_MAX_FILE_SIZE=10MB
ATTACHMENT_MAX_TOTAL_SIZE=50MB
ATTACHMENT_MAX_REQUEST_SIZE=55MB
ATTACHMENT_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif,application/pdf
TICKET_RESOLUTION_CONFIRMATION_DURATION=72h
TICKET_RESOLUTION_CONFIRMATION_SCAN_DELAY=60000
TICKET_DUPLICATE_SEARCH_RADIUS_METERS=500
TICKET_DUPLICATE_SEARCH_TIME_WINDOW=24h

# Ayuda con IA (apagada por defecto). La clave es de Google AI Studio; nunca se commitea.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_MAX_REQUESTS_PER_MINUTE=10
