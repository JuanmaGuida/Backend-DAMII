<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.reclamos</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Boot 4.1.2 still manages 5.30.0; 5.34.0 fixes the reported AMQP advisories. -->
		<rabbit-amqp-client.version>5.34.0</rabbit-amqp-client.version>
		<sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
		<sonar.python.coverage.reportPaths>target/python-coverage/python-coverage.xml</sonar.python.coverage.reportPaths>
		<!-- Keep CI helper tests analyzed as tests, not uncovered production Python. -->
		<sonar.tests>src/test/java,.github/tests</sonar.tests>
		<sonar.exclusions>.github/tests/**</sonar.exclusions>
		<jacoco.version>0.8.13</jacoco.version>
		<!-- TST-02: minimums for the business layer (service + entity), see jacoco-check-business. -->
		<coverage.business.line.min>0.80</coverage.business.line.min>
		<coverage.business.branch.min>0.70</coverage.business.branch.min>
		<jjwt.version>0.13.0</jjwt.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers</artifactId>
			<scope>test</scope>
			<!-- zerodep embeds vulnerable HttpComponents; Boot cannot manage shaded copies. -->
			<exclusions>
				<exclusion>
					<groupId>com.github.docker-java</groupId>
					<artifactId>docker-java-transport-zerodep</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- Keep docker-java aligned with Testcontainers; let Boot manage HttpComponents. -->
		<dependency>
			<groupId>com.github.docker-java</groupId>
			<artifactId>docker-java-transport-httpclient5</artifactId>
			<version>3.7.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-standalone</artifactId>
			<version>3.13.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.rabbitmq</groupId>
			<artifactId>amqp-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.httpcomponents.client5</groupId>
			<artifactId>httpclient5</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.networknt</groupId>
			<artifactId>json-schema-validator</artifactId>
			<version>1.5.9</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.yaml</groupId>
			<artifactId>snakeyaml</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<!-- Tool-only CVE-2025-67030 fix until the plugin updates its transitive dependency. -->
				<dependencies>
					<dependency>
						<groupId>org.codehaus.plexus</groupId>
						<artifactId>plexus-utils</artifactId>
						<version>3.6.1</version>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<!-- Tool-only fixes for CVE-2025-67030 and CVE-2024-47554. -->
				<dependencies>
					<dependency>
						<groupId>org.codehaus.plexus</groupId>
						<artifactId>plexus-utils</artifactId>
						<version>3.6.1</version>
					</dependency>
					<dependency>
						<groupId>commons-io</groupId>
						<artifactId>commons-io</artifactId>
						<version>2.14.0</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.85</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
					<execution>
						<id>jacoco-check-business</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<!-- Business layer only. If these patterns match no class JaCoCo skips the rule silently, so keep them aligned with the package names. -->
							<includes>
								<include>com/reclamos/backend/service/**</include>
								<include>com/reclamos/backend/entity/**</include>
							</includes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${coverage.business.line.min}</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>${coverage.business.branch.min}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<!-- Keep the compiler's Plexus 4 API; patch only its vulnerable tool dependencies. -->
				<dependencies>
					<dependency>
						<groupId>org.codehaus.plexus</groupId>
						<artifactId>plexus-utils</artifactId>
						<version>4.0.3</version>
					</dependency>
					<dependency>
						<groupId>commons-io</groupId>
						<artifactId>commons-io</artifactId>
						<version>2.14.0</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<!-- Tool-only CVE-2025-67030 fix; keep the clean plugin on its Plexus 4 API. -->
				<dependencies>
					<dependency>
						<groupId>org.codehaus.plexus</groupId>
						<artifactId>plexus-utils</artifactId>
						<version>4.0.3</version>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<!-- Tool-only CVE-2025-67030 fix; retain the inherited plugin version. -->
				<dependencies>
					<dependency>
						<groupId>org.codehaus.plexus</groupId>
						<artifactId>plexus-utils</artifactId>
						<version>3.6.1</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>pitest</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<version>1.30.1</version>
						<dependencies>
							<dependency>
								<groupId>org.pitest</groupId>
								<artifactId>pitest-junit5-plugin</artifactId>
								<version>1.2.3</version>
							</dependency>
						</dependencies>
						<configuration>
							<!-- The PostgreSQL integration tests share one disposable database. -->
							<threads>1</threads>
							<!-- Allow a cold Spring context to start in each PIT worker. -->
							<timeoutConstant>25000</timeoutConstant>
							<outputFormats>
								<format>HTML</format>
								<format>XML</format>
							</outputFormats>
							<targetClasses>
								<!-- Ticket lifecycle, state transitions and duplicate detection -->
								<param>com.reclamos.backend.entity.Ticket</param>
								<param>com.reclamos.backend.entity.TicketState*</param>
								<param>com.reclamos.backend.service.TicketService</param>
								<param>com.reclamos.backend.service.TicketStatusUpdateService</param>
								<param>com.reclamos.backend.service.TicketResolutionService*</param>
								<param>com.reclamos.backend.service.ResolutionConfirmationTimeoutService</param>
								<param>com.reclamos.backend.service.TicketCancellationRequestService</param>
								<param>com.reclamos.backend.service.TicketCancellationConflictService</param>
								<param>com.reclamos.backend.service.DuplicateTicketService</param>
								<param>com.reclamos.backend.service.DuplicateCandidateService*</param>
								<param>com.reclamos.backend.service.HaversineDistanceCalculator</param>
								<!-- Risk, priority and configuration invariants -->
								<param>com.reclamos.backend.service.RiskCalculationService*</param>
								<param>com.reclamos.backend.service.RiskScalePolicy</param>
								<param>com.reclamos.backend.service.RiskAssessment</param>
								<param>com.reclamos.backend.service.PriorityCalculationService*</param>
								<param>com.reclamos.backend.service.TicketPriorityService</param>
								<param>com.reclamos.backend.config.PriorityProperties*</param>
								<!-- SLA policies, cycles, milestones and escalation precedence -->
								<param>com.reclamos.backend.entity.SlaPolicy</param>
								<param>com.reclamos.backend.entity.WorkCalendar</param>
								<param>com.reclamos.backend.service.SlaCalculationService*</param>
								<param>com.reclamos.backend.service.TicketSlaService*</param>
								<param>com.reclamos.backend.service.TicketSlaMilestoneService</param>
								<!-- Form validation, reclassification and information requests -->
								<param>com.reclamos.backend.service.FormValidationService*</param>
								<param>com.reclamos.backend.service.TicketReclassificationService</param>
								<param>com.reclamos.backend.service.ReclassificationDataService</param>
								<param>com.reclamos.backend.service.InformationRequestService*</param>
								<param>com.reclamos.backend.service.InformationRequestDeadlineService</param>
								<param>com.reclamos.backend.service.InformationRequestExpirationService</param>
							</targetClasses>
							<targetTests>
								<param>com.reclamos.backend.entity.TicketStateTest</param>
								<param>com.reclamos.backend.service.TicketServiceTest</param>
								<param>com.reclamos.backend.service.TicketStatusUpdateServiceTest</param>
								<param>com.reclamos.backend.service.TicketResolutionServiceTest</param>
								<param>com.reclamos.backend.service.ResolutionConfirmationTimeoutServiceTest</param>
								<param>com.reclamos.backend.service.TicketCancellationRequestServiceTest</param>
								<param>com.reclamos.backend.service.DuplicateTicketServiceTest</param>
								<param>com.reclamos.backend.service.DuplicateCandidateServiceTest</param>
								<param>com.reclamos.backend.service.HaversineDistanceCalculatorTest</param>
								<param>com.reclamos.backend.service.RiskCalculationServiceTest</param>
								<param>com.reclamos.backend.service.RiskScalePolicyTest</param>
								<param>com.reclamos.backend.service.PriorityCalculationServiceTest</param>
								<param>com.reclamos.backend.service.PriorityPropertiesBindingTest</param>
								<param>com.reclamos.backend.entity.SlaConfigurationValidationTest</param>
								<param>com.reclamos.backend.service.SlaCalculationServiceTest</param>
								<param>com.reclamos.backend.service.TicketSlaServiceTest</param>
								<param>com.reclamos.backend.service.ResolutionSlaMilestoneServiceTest</param>
								<param>com.reclamos.backend.service.TicketEscalationPrecedenceTest</param>
								<param>com.reclamos.backend.service.FormValidationServiceTest</param>
								<param>com.reclamos.backend.service.ReclassificationFormValidationTest</param>
								<param>com.reclamos.backend.service.RoutedFormSnapshotTest</param>
								<param>com.reclamos.backend.service.InformationRequestServiceTest</param>
								<param>com.reclamos.backend.service.InformationRequestDeadlineServiceTest</param>
								<param>com.reclamos.backend.service.InformationRequestExpirationServiceTest</param>
								<param>com.reclamos.backend.service.TicketReclassificationPostgresIntegrationTest</param>
								<param>com.reclamos.backend.service.TicketCancellationPostgresIntegrationTest</param>
							</targetTests>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
